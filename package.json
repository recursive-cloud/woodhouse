{
  "name": "woodhouse",
  "version": "1.1.0",
  "private": true,
  "description": "A personal butler for GitHub repositories: settings sync, auto-approval, and check consolidation.",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:generate": "tsx scripts/generate-schema.ts",
    "schema:check": "tsx scripts/check-schema.ts"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "js-yaml": "^4.1.0",
    "pino": "^10.4.0",
    "probot": "^13.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "4.7.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=24"
  }
}
