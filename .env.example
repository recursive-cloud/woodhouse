# --- GitHub App credentials -------------------------------------------------
APP_ID=
# Raw PEM contents, or a base64 encoding of them (easier in k8s manifests).
PRIVATE_KEY=
WEBHOOK_SECRET=

# --- Security ---------------------------------------------------------------
# REQUIRED. JSON array or comma-separated list of owners this app will act on.
# Events from any other owner are dropped. There is no wildcard; an empty value
# is a startup error, not "allow everything".
ALLOWED_INSTALLATION_TARGETS=["my-github-username","my-homelab-org"]

# Repository holding the owner-wide baseline config. Defaults to
# `.github-private`, deliberately not `.github`: that repository must be public
# for GitHub's built-in community-health and org-profile features to apply to
# public repos, and this config contains your auto-approval actor list.
# BASELINE_REPO=.github-private

# --- Runtime ----------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# Evaluate and log every decision, but never write to GitHub. Useful for the
# first run against a real repository.
DRY_RUN=false
